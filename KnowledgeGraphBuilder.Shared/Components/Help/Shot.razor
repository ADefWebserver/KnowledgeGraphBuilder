@* A help-guide screenshot from wwwroot/help, taken in the light theme. *@
<figure class="kgb-shot @(Narrow ? "narrow" : null)">
    @* Not lazy: pictures loading during a jump to a section would push the section down past where it scrolled. *@
    <img src="@($"_content/KnowledgeGraphBuilder.Shared/help/{Name}.png")" alt="@Caption" />
    <figcaption>@Caption</figcaption>
</figure>

@code {
    /// <summary>File name in wwwroot/help, without ".png".</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter, EditorRequired] public string Caption { get; set; } = "";

    /// <summary>Shows a tall or cropped picture at a smaller width.</summary>
    [Parameter] public bool Narrow { get; set; }
}
