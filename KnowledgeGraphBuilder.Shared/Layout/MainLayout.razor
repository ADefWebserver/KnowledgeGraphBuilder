@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService Theme
@inject IHostCapabilities Host
@inject NavigationManager Nav

<RadzenTheme Theme="material" />

<div class="kgb-app @(IsDark ? "kgb-dark" : "kgb-light")">
    @* Inside the themed container so dialogs, menus and toasts get the kgb tokens. *@
    <RadzenComponents />
    <header class="kgb-header">
        <a class="row" href="./" style="text-decoration:none;gap:10px">
            <span class="kgb-logo" aria-hidden="true"><span class="mi s16">hub</span></span>
            <span class="kgb-appname">Knowledge Graph Builder</span>
        </a>
        <span class="kgb-rootchip" title="@Host.RootPath"><span class="mi s14" aria-hidden="true">@(Host.IsBrowser ? "public" : "folder")</span>@Host.RootDisplay</span>
        <span class="grow"></span>
        <NavLink class="kgb-nav" href="./" Match="NavLinkMatch.All" ActiveClass="active" title="Workspace" data-tour="nav-workspace"><span class="mi s16" aria-hidden="true">edit_note</span><span class="lbl">Workspace</span></NavLink>
        <NavLink class="kgb-nav" href="graph" ActiveClass="active" title="Graph" data-tour="nav-graph"><span class="mi s16" aria-hidden="true">hub</span><span class="lbl">Graph</span></NavLink>
        <NavLink class="kgb-nav" href="settings" ActiveClass="active" title="Settings" data-tour="nav-settings"><span class="mi s16" aria-hidden="true">settings</span><span class="lbl">Settings</span></NavLink>
        <NavLink class="kgb-nav kgb-nav-help" href="help" ActiveClass="active" title="Help guide and guided tour" data-tour="nav-help"><span class="mi s16" aria-hidden="true">help</span>Help</NavLink>
        @if (Host.CanToggleTheme)
        {
            <RadzenAppearanceToggle LightTheme="material" DarkTheme="material-dark" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" />
        }
    </header>
    <main class="kgb-workspace">
        @Body
    </main>
    <footer class="kgb-footer">
        <a href="https://BlazorData.net" target="_blank" rel="noopener">(C) BlazorData.net</a>
    </footer>
</div>

@code {
    bool IsDark => Theme.Theme?.Contains("dark", StringComparison.OrdinalIgnoreCase) == true;

    protected override void OnInitialized() => Theme.ThemeChanged += OnThemeChanged;

    void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.ThemeChanged -= OnThemeChanged;
}
